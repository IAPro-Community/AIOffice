{
  "manifest_version": 3,
  "name": "AIOffice — painel e notificações",
  "version": "0.1.1",
  "description": "Acompanhe agentes do AIOffice no painel lateral do Chrome.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "notifications",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir AIOffice",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
