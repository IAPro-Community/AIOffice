{
  "name": "aioffice",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "description": "AIOffice - Virtual AI Office & Studio unindo Orquestrador-Maestro, OpenOrq, Habblaud, oh-my-pi e replica-skill",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IAPro-Community/AIOffice.git"
  },
  "homepage": "https://github.com/IAPro-Community/AIOffice#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build && npm --prefix apps/office-web run build",
    "build:packages": "tsc --build",
    "build:office": "npm --prefix apps/office-web run build",
    "typecheck": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "node --experimental-strip-types --test \"packages/*/test/*.test.ts\" \"apps/office-cli/test/*.test.ts\"",
    "start": "node apps/office-cli/dist/cli.js",
    "start:office": "node apps/office-web/scripts/start-managed.mjs",
    "remote:setup": "npm --prefix apps/office-web run remote:setup --",
    "remote:off": "npm --prefix apps/office-web run remote:setup -- --off",
    "setup": "npm install && npm --prefix apps/office-web install && npm run build",
    "check:habblaud-upstream": "node scripts/check-habblaud-upstream.mjs",
    "release": "node scripts/release-aioffice.mjs",
    "install:mcp": "node scripts/install-mcp-bridges.mjs",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
